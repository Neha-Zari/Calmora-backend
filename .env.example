JWT_SECRET_KEY=replace-with-a-long-random-secret
RESET_SECRET=replace-with-another-long-random-secret
FRONTEND_URL=http://192.168.1.5:5173/
COOKIE_SECURE=false

# Existing chatbot Llama 4 Scout integration
OPENROUTER_API_KEY=

# Email / SMTP (Gmail example: use an App Password, not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Google Sign-In
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/auth/google/callback

# Optional company-issued doctor account (created/updated at backend startup)
DOCTOR_EMAIL=doctor@company.com
DOCTOR_PASSWORD=change-this-password

# Web Push / reminders
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:your-email@example.com
